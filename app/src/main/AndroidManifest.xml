<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/Theme.DevWidgets">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.DevActivityWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.sangrechy.devwidgets.ACTION_FORCE_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_dev_activity_info" />
        </receiver>

        <receiver
            android:name=".widget.LeetCodeWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.sangrechy.devwidgets.ACTION_FORCE_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_leetcode_info" />
        </receiver>

        <receiver
            android:name=".widget.GitHubWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.sangrechy.devwidgets.ACTION_FORCE_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_github_info" />
        </receiver>

        <receiver
            android:name=".widget.LeetCodeHeatmapWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.sangrechy.devwidgets.ACTION_FORCE_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_leetcode_heatmap_info" />
        </receiver>

        <receiver
            android:name=".widget.GitHubHeatmapWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.sangrechy.devwidgets.ACTION_FORCE_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_github_heatmap_info" />
        </receiver>

        <receiver
            android:name=".widget.LeetCodeCircleWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.sangrechy.devwidgets.ACTION_FORCE_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_leetcode_circle_info" />
        </receiver>

        <receiver
            android:name=".widget.GitHubCircleWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.sangrechy.devwidgets.ACTION_FORCE_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_github_circle_info" />
        </receiver>

        <receiver
            android:name=".widget.CombinedHeatmapWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.sangrechy.devwidgets.ACTION_FORCE_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_combined_heatmap_info" />
        </receiver>

        <receiver
            android:name=".widget.AutoRefreshReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.sangrechy.devwidgets.ACTION_AUTO_REFRESH_TICK" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
