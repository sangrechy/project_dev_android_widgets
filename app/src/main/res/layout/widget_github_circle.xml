<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/iv_widget_wallpaper_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/v_widget_wallpaper_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/widget_glass_chassis"
        android:padding="8dp">

        <!-- Compact Inner Glass Div (Element floating over Wallpaper Chassis) -->
        <LinearLayout
            android:id="@+id/section_github"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/widget_glass_card"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp">

            <!-- Card Header Bar -->
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp">

                <LinearLayout
                    android:id="@+id/header_right_wrap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="8dp">

                    <ImageView
                        android:id="@+id/btn_refresh"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="@drawable/widget_icon_button_glass"
                        android:padding="3dp"
                        android:src="@drawable/ic_refresh"
                        android:contentDescription="Refresh" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@id/header_right_wrap"
                    android:layout_centerVertical="true">

                    <ImageView
                        android:id="@+id/iv_gh_brand_logo"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_github_logo"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="GitHub Logo" />

                    <TextView
                        android:id="@+id/tv_gh_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GitHub"
                        android:textColor="#3FB950"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:singleLine="true" />

                    <TextView
                        android:id="@+id/tv_gh_user_tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:text="(@dev)"
                        android:textColor="#94A3B8"
                        android:textSize="9sp"
                        android:singleLine="true"
                        android:ellipsize="end" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Centered GitHub Radar / Contribution Circle -->
            <ImageView
                android:id="@+id/iv_github_typemap"
                android:layout_width="114dp"
                android:layout_height="114dp"
                android:scaleType="fitCenter"
                android:contentDescription="GitHub Contribution Circle" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
