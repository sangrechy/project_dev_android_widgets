<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/iv_widget_wallpaper_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/v_widget_wallpaper_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/widget_glass_chassis"
        android:padding="10dp">

        <!-- Top Header Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp">

            <LinearLayout
                android:id="@+id/header_right_wrap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true">

                <ImageView
                    android:id="@+id/btn_refresh"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/widget_icon_button_glass"
                    android:padding="4dp"
                    android:src="@drawable/ic_refresh"
                    android:contentDescription="Refresh" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/header_right_wrap"
                android:layout_centerVertical="true">

                <ImageView
                    android:id="@+id/iv_lc_brand_logo"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_leetcode_logo"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="LeetCode Logo" />

                <TextView
                    android:id="@+id/tv_lc_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LeetCode"
                    android:textColor="#FFA116"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/tv_lc_user_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="(@dev)"
                    android:textColor="#94A3B8"
                    android:textSize="10sp"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Circle Gauge Only Card -->
        <LinearLayout
            android:id="@+id/section_leetcode"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/widget_glass_card"
            android:padding="6dp"
            android:gravity="center">

            <ImageView
                android:id="@+id/iv_leetcode_circle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:contentDescription="LeetCode Gauge" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
