<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_glass_chassis"
    android:padding="12dp">

    <!-- Top Header Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:paddingHorizontal="4dp">

        <LinearLayout
            android:id="@+id/header_right_wrap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true">

            <TextView
                android:id="@+id/tv_last_updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sync: Just now"
                android:textColor="#CBD5E1"
                android:textSize="10.5sp"
                android:layout_marginEnd="8dp" />

            <ImageView
                android:id="@+id/btn_refresh"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/widget_icon_button_glass"
                android:padding="4dp"
                android:src="@drawable/ic_refresh"
                android:contentDescription="Refresh" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/header_right_wrap"
            android:layout_marginEnd="8dp"
            android:layout_centerVertical="true">

            <TextView
                android:id="@+id/tv_widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dev Life"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:singleLine="true" />
        </LinearLayout>
    </RelativeLayout>

    <!-- SECTION 1: LEETCODE GLASS CARD -->
    <LinearLayout
        android:id="@+id/section_leetcode"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/widget_glass_card"
        android:padding="10dp"
        android:layout_marginBottom="8dp">

        <!-- Card Section Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:paddingHorizontal="2dp">

            <TextView
                android:id="@+id/tv_lc_user_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@dev"
                android:textColor="#94A3B8"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:layout_alignParentEnd="true" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/tv_lc_user_tag"
                android:layout_marginEnd="6dp">

                <ImageView
                    android:id="@+id/iv_lc_brand_logo"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_leetcode_logo"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="LeetCode" />

                <TextView
                    android:id="@+id/tv_lc_section_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LeetCode"
                    android:textColor="#FFA116"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Top Visual Row: Gauge (Left) + Detailed Stat Badges (Right) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <ImageView
                android:id="@+id/iv_leetcode_circle"
                android:layout_width="105dp"
                android:layout_height="105dp"
                android:scaleType="fitCenter"
                android:contentDescription="LeetCode Solved Gauge" />

            <!-- 2x2 Glass Stat Badges Grid -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <!-- Row 1: Easy & Medium -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/widget_glass_pill"
                        android:paddingVertical="5dp"
                        android:paddingHorizontal="8dp"
                        android:gravity="center"
                        android:layout_marginEnd="6dp">

                        <TextView
                            android:id="@+id/tv_lc_easy_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_lc_easy_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Easy"
                            android:textColor="#00B8A3"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/widget_glass_pill"
                        android:paddingVertical="5dp"
                        android:paddingHorizontal="8dp"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tv_lc_medium_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_lc_medium_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Medium"
                            android:textColor="#FFA116"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 2: Hard & Acceptance Rate -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/widget_glass_pill"
                        android:paddingVertical="5dp"
                        android:paddingHorizontal="8dp"
                        android:gravity="center"
                        android:layout_marginEnd="6dp">

                        <TextView
                            android:id="@+id/tv_lc_hard_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_lc_hard_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hard"
                            android:textColor="#EF4743"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/widget_glass_pill"
                        android:paddingVertical="5dp"
                        android:paddingHorizontal="8dp"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tv_lc_acc_rate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_lc_acc_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Solved"
                            android:textColor="#60A5FA"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Subtle Frosted Horizontal Divider -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1FFFFFFF"
            android:layout_marginBottom="6dp" />

        <!-- Bottom: Full-Width 2-Tier 1-Year Heatmap -->
        <ImageView
            android:id="@+id/iv_leetcode_heatmap"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scaleType="fitCenter"
            android:contentDescription="LeetCode Submission Heatmap" />
    </LinearLayout>

    <!-- SECTION 2: GITHUB GLASS CARD -->
    <LinearLayout
        android:id="@+id/section_github"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/widget_glass_card"
        android:padding="10dp">

        <!-- Card Section Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:paddingHorizontal="2dp">

            <TextView
                android:id="@+id/tv_gh_user_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@dev"
                android:textColor="#94A3B8"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:layout_alignParentEnd="true" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/tv_gh_user_tag"
                android:layout_marginEnd="6dp">

                <ImageView
                    android:id="@+id/iv_gh_brand_logo"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_github_logo"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="GitHub" />

                <TextView
                    android:id="@+id/tv_gh_section_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GitHub"
                    android:textColor="#3FB950"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Top Visual Row: Large Spider Radar + Graph (Left) + Detailed Stat Badges (Right) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <ImageView
                android:id="@+id/iv_github_typemap"
                android:layout_width="105dp"
                android:layout_height="105dp"
                android:scaleType="fitCenter"
                android:contentDescription="GitHub Contribution Spider Radar" />

            <!-- 2x2 Glass Stat Badges Grid -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <!-- Row 1: Commits & Pull Requests -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/widget_glass_pill"
                        android:paddingVertical="5dp"
                        android:paddingHorizontal="8dp"
                        android:gravity="center"
                        android:layout_marginEnd="6dp">

                        <TextView
                            android:id="@+id/tv_gh_commits_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_gh_commits_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Commits"
                            android:textColor="#22C55E"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/widget_glass_pill"
                        android:paddingVertical="5dp"
                        android:paddingHorizontal="8dp"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tv_gh_prs_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_gh_prs_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pull Req"
                            android:textColor="#A855F7"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 2: Issues & Reviews -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/widget_glass_pill"
                        android:paddingVertical="5dp"
                        android:paddingHorizontal="8dp"
                        android:gravity="center"
                        android:layout_marginEnd="6dp">

                        <TextView
                            android:id="@+id/tv_gh_issues_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_gh_issues_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Issues"
                            android:textColor="#F59E0B"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/widget_glass_pill"
                        android:paddingVertical="5dp"
                        android:paddingHorizontal="8dp"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tv_gh_reviews_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_gh_reviews_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Reviews"
                            android:textColor="#06B6D4"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Subtle Frosted Horizontal Divider -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1FFFFFFF"
            android:layout_marginBottom="6dp" />

        <!-- Bottom: Full-Width 2-Tier 1-Year Heatmap -->
        <ImageView
            android:id="@+id/iv_github_heatmap"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scaleType="fitCenter"
            android:contentDescription="GitHub Contribution Heatmap" />
    </LinearLayout>
</LinearLayout>
