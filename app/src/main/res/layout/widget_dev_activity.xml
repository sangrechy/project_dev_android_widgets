<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_glass_chassis"
    android:padding="12dp">

    <!-- Top Header Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:paddingHorizontal="4dp">

        <LinearLayout
            android:id="@+id/header_right_wrap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true">

            <TextView
                android:id="@+id/tv_last_updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sync: Just now"
                android:textColor="#CBD5E1"
                android:textSize="10.5sp"
                android:layout_marginEnd="8dp" />

            <ImageView
                android:id="@+id/btn_refresh"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/widget_icon_button_glass"
                android:padding="4dp"
                android:src="@drawable/ic_refresh"
                android:contentDescription="Refresh" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/header_right_wrap"
            android:layout_marginEnd="8dp"
            android:layout_centerVertical="true">

            <TextView
                android:id="@+id/tv_widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dev Life"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:singleLine="true" />
        </LinearLayout>
    </RelativeLayout>

    <!-- SECTION 1: LEETCODE GLASS CARD -->
    <LinearLayout
        android:id="@+id/section_leetcode"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/widget_glass_card"
        android:padding="10dp"
        android:layout_marginBottom="8dp">

        <!-- Card Section Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:paddingHorizontal="2dp">

            <TextView
                android:id="@+id/tv_lc_user_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@dev"
                android:textColor="#94A3B8"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:layout_alignParentEnd="true" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/tv_lc_user_tag"
                android:layout_marginEnd="6dp">

                <ImageView
                    android:id="@+id/iv_lc_brand_logo"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_leetcode_logo"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="LeetCode" />

                <TextView
                    android:id="@+id/tv_lc_section_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LeetCode"
                    android:textColor="#FFA116"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Visual Row: Gauge (Left 42%) + Heatmap (Right 58%) -->
        <LinearLayout
            android:id="@+id/ll_lc_visual_row"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- 3/4 Circular Speedometer Gauge with Easy/Med/Hard inside -->
            <ImageView
                android:id="@+id/iv_leetcode_circle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="42"
                android:scaleType="fitCenter"
                android:contentDescription="LeetCode Solved Count" />

            <FrameLayout
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#26FFFFFF"
                android:layout_marginHorizontal="6dp" />

            <!-- Dynamic 1-Year Submission Heatmap filling the space -->
            <ImageView
                android:id="@+id/iv_leetcode_heatmap"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="58"
                android:scaleType="fitCenter"
                android:contentDescription="LeetCode Submission Heatmap" />
        </LinearLayout>
    </LinearLayout>

    <!-- SECTION 2: GITHUB GLASS CARD -->
    <LinearLayout
        android:id="@+id/section_github"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/widget_glass_card"
        android:padding="10dp">

        <!-- Card Section Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:paddingHorizontal="2dp">

            <TextView
                android:id="@+id/tv_gh_user_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@dev"
                android:textColor="#94A3B8"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:layout_alignParentEnd="true" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/tv_gh_user_tag"
                android:layout_marginEnd="6dp">

                <ImageView
                    android:id="@+id/iv_gh_brand_logo"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_github_logo"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="GitHub" />

                <TextView
                    android:id="@+id/tv_gh_section_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GitHub"
                    android:textColor="#3FB950"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Visual Row: Large Spider Radar + Graph (Left 42%) + Heatmap (Right 58%) -->
        <LinearLayout
            android:id="@+id/ll_gh_visual_row"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- GitHub Activity Overview Spider Radar Chart with Commits/PRs/Issues/Reviews -->
            <ImageView
                android:id="@+id/iv_github_typemap"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="42"
                android:scaleType="fitCenter"
                android:contentDescription="GitHub Contribution Type Map" />

            <FrameLayout
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#26FFFFFF"
                android:layout_marginHorizontal="6dp" />

            <!-- Dynamic 1-Year Contribution Heatmap filling the space -->
            <ImageView
                android:id="@+id/iv_github_heatmap"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="58"
                android:scaleType="fitCenter"
                android:contentDescription="GitHub Contribution Heatmap" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
